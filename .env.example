# ── 数据库 ───────────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=change_me_db_password
DB_NAME=photogiraffe

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ── MinIO 对象存储 ────────────────────────────────────────────────────────────
MINIO_USER=admin
MINIO_PASSWORD=change_me_minio_password

# ── 安全（必填，生产环境务必替换为随机字符串）───────────────────────────────────
# 快速生成密钥:
# JWT_SECRET: openssl rand -hex 32
# INTERNAL_SECRET: openssl rand -hex 24
# Go Core ↔ Python Worker 内部通信密钥
# 生成: openssl rand -hex 24
INTERNAL_SECRET=change_me_internal_secret_48_chars_minimum

# JWT 签名密钥（HS256 兼容期兜底）
# 生成: openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret_32_chars_minimum

# JWT RSA 私钥/公钥路径（RS256）
# 生成私钥（PKCS#8）: openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt -out go-core/keys/jwt-private.pem
# 导出公钥: openssl rsa -in go-core/keys/jwt-private.pem -pubout -out go-core/keys/jwt-public.pem
JWT_PRIVATE_KEY_PATH=go-core/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=go-core/keys/jwt-public.pem

# JWT Key ID（JWKS kid）
JWT_KEY_ID=2026-03-09

# HS256 兼容截止时间（RFC3339，建议部署后 +7 天）
# 示例: 2026-03-16T00:00:00Z
JWT_HS256_GRACE_UNTIL=2026-03-16T00:00:00Z

# 可选：RS256 上线时间（RFC3339）；如未设置 JWT_HS256_GRACE_UNTIL，则自动按上线时间 +7 天
JWT_RS256_DEPLOYED_AT=2026-03-09T00:00:00Z

# ── CORS ─────────────────────────────────────────────────────────────────────
# 允许访问 Go Core API 的前端来源（生产环境改为你的域名）
CORS_ALLOW_ORIGIN=http://localhost:3000
